
# CORS for authentication endpoint (only allow frontend)
AUTH_ENDPOINT_CORS_ALLOW_ORIGIN=http://localhost:5000

# GCP Info
# Not needed if deployed with firebase
# You can download this JSON from https://console.cloud.google.com/apis/credentials
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_CREDENTIALS_JSON={"type": "service_account","project_id": "YOUR_GCP_PROJECT_ID","private_key_id": "YOUR_GCP_PRIVATE_KEY_ID","private_key": "YOUR_GCP_PRIVATE_KEY","client_email": "YOUR_GCP_CLIENT_EMAIL","client_id": "YOUR_GCP_CLIENT_ID","auth_uri": "https://accounts.google.com/o/oauth2/auth","token_uri": "https://oauth2.googleapis.com/token","auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url": "YOUR_GCP_CLIENT_X509_CERT_URL","universe_domain": "googleapis.com"}

NODE_ENV=production

# Firestore configurations (optional)
DB_TYPE=firestore

# MongoDB configurations (optional)
# DB_TYPE=mongo
# MONGO_HOST=mongodb
# MONGO_USERNAME=YOUR_MONGO_DB_ADMIN
# MONGO_PASSWORD=YOUR_MONGO_DB_PASSWORD
# MONGO_DATABASE=default
