POST http://localhost:8080/v1/responses
Content-Type: application/json

{
    "instructions": "You're an AI agent that reads all text from the images provided by the user. Output exactly what the image contains.",
    "temperature": 0,
    "input": [
        {
            "role": "user", 
            "content": [
                {
                    "type": "input_text",
                    "text": "Here is the receipt"
                },
                {
                    "type": "input_image",
                    "image_url": "data:image/png;base64,"
                }
            ]
        }
    ]
}
